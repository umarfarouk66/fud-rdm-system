# Hardened Storage Security Policy
# Prevent direct script execution and directory browsing inside storage

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .cgi .pl .py .asp .exe
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps .cgi .pl .py .asp .exe

Options -Indexes
